@model List<DAANAY.Models.Product>
@{
    ViewData["Title"] = "Inventory";
}

<div class="page-header mb-4">
    <h2 class="mb-1">Inventory</h2>
    <p class="text-muted mb-0">Stock levels sorted low to high. Items under 15 are marked low.</p>
</div>

<div class="table-responsive dashboard-box p-0">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
            <tr>
                <th>Product</th>
                <th>Category</th>
                <th>Unit</th>
                <th>Stock</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var product in Model)
        {
            var low = product.Stock < 15;
            <tr class="@(low ? "table-warning" : "")">
                <td>@product.Name</td>
                <td>@product.CategoryName</td>
                <td>@product.Unit</td>
                <td>@product.Stock</td>
                <td>
                    @if (low)
                    {
                        <span class="badge bg-warning text-dark">Low Stock</span>
                    }
                    else
                    {
                        <span class="badge bg-success">OK</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<p class="mt-3 mb-0">
    <a asp-action="Dashboard">Back to Dashboard</a>
</p>
