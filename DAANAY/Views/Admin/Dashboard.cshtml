@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="dashboard-box">
    <h2>Admin Dashboard</h2>
    <p class="mb-1">Welcome, <strong>@ViewBag.FullName</strong>.</p>
    <p class="text-muted">Logged in as: @ViewBag.Email</p>

    <hr />

    <p>This area is for administrators only.</p>
    <p class="text-muted small">Product, category, inventory, and order management will be added in later modules.</p>
</div>
