@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header mb-4">
    <h2 class="mb-1">Admin Dashboard</h2>
    <p class="text-muted mb-0">Manage products, categories, inventory, customers, and orders.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-box text-center">
            <div class="stat-number">@ViewBag.ProductCount</div>
            <div class="stat-label">Products</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-box text-center">
            <div class="stat-number">@ViewBag.CategoryCount</div>
            <div class="stat-label">Categories</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-box text-center">
            <div class="stat-number">@ViewBag.OrderCount</div>
            <div class="stat-label">Orders</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-box text-center">
            <div class="stat-number">@ViewBag.PendingOrders</div>
            <div class="stat-label">Pending</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-box text-center">
            <div class="stat-number">@ViewBag.CustomerCount</div>
            <div class="stat-label">Customers</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-box text-center">
            <div class="stat-number">@ViewBag.LowStock</div>
            <div class="stat-label">Low Stock</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="dashboard-box h-100">
            <h5>Products</h5>
            <p class="text-muted">Create, edit, and delete dry fruit products.</p>
            <a class="btn btn-daanay btn-sm" asp-action="Products">Manage Products</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-box h-100">
            <h5>Categories</h5>
            <p class="text-muted">Organize nuts, dried fruits, seeds, and gifts.</p>
            <a class="btn btn-daanay btn-sm" asp-action="Categories">Manage Categories</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-box h-100">
            <h5>Orders</h5>
            <p class="text-muted">Update status: Pending → Confirmed → Shipped → Delivered.</p>
            <a class="btn btn-daanay btn-sm" asp-action="Orders">Manage Orders</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-box h-100">
            <h5>Inventory</h5>
            <p class="text-muted">Check stock levels across products.</p>
            <a class="btn btn-outline-daanay btn-sm" asp-action="Inventory">View Inventory</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-box h-100">
            <h5>Customers</h5>
            <p class="text-muted">Browse registered customer sample records.</p>
            <a class="btn btn-outline-daanay btn-sm" asp-action="Customers">View Customers</a>
        </div>
    </div>
</div>
