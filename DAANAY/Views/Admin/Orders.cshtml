@model List<DAANAY.Models.Order>
@{
    ViewData["Title"] = "Manage Orders";
}

<div class="page-header mb-4">
    <h2 class="mb-1">Orders</h2>
    <p class="text-muted mb-0">Process customer orders and update status.</p>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<div class="table-responsive dashboard-box p-0">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
            <tr>
                <th>Order #</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Status</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.CustomerName</td>
                <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                <td><span class="badge status-@order.Status.ToLowerInvariant()">@order.Status</span></td>
                <td>PKR @order.TotalAmount.ToString("N0")</td>
                <td>
                    <a class="btn btn-sm btn-outline-daanay" asp-action="OrderDetails" asp-route-id="@order.Id">Manage</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<p class="mt-3 mb-0">
    <a asp-action="Dashboard">Back to Dashboard</a>
</p>
