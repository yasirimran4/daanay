@model List<DAANAY.Models.Category>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Categories</h2>
        <p class="text-muted mb-0">Admin category management (sample data).</p>
    </div>
    <a class="btn btn-daanay" asp-action="CreateCategory">Add Category</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<div class="table-responsive dashboard-box p-0">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
                <td>@category.Description</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<p class="mt-3 mb-0">
    <a asp-action="Dashboard">Back to Dashboard</a>
</p>
