@model List<DAANAY.Models.CustomerInfo>
@{
    ViewData["Title"] = "Customers";
}

<div class="page-header mb-4">
    <h2 class="mb-1">Customers</h2>
    <p class="text-muted mb-0">Sample customer records for admin view.</p>
</div>

<div class="table-responsive dashboard-box p-0">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Orders</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.FullName</td>
                <td>@customer.Email</td>
                <td>@customer.Phone</td>
                <td>@customer.Address</td>
                <td>@customer.TotalOrders</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<p class="mt-3 mb-0">
    <a asp-action="Dashboard">Back to Dashboard</a>
</p>
