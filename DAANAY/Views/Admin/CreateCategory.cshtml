@model DAANAY.ViewModels.CategoryFormViewModel
@{
    ViewData["Title"] = "Add Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="dashboard-box">
            <h2 class="mb-3">Add Category</h2>
            <form asp-action="CreateCategory" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-daanay">Save Category</button>
                <a class="btn btn-outline-secondary" asp-action="Categories">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
