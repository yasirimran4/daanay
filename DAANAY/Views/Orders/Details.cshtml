@model DAANAY.Models.Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<div class="dashboard-box mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-1">Order #@Model.Id</h2>
            <p class="text-muted mb-0">@Model.OrderDate.ToString("dd MMM yyyy HH:mm")</p>
        </div>
        <span class="badge status-@Model.Status.ToLowerInvariant() fs-6">@Model.Status</span>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <p class="mb-1"><strong>Customer:</strong> @Model.CustomerName</p>
            <p class="mb-1"><strong>Phone:</strong> @Model.Phone</p>
            <p class="mb-0"><strong>Payment:</strong> @Model.PaymentMethod</p>
        </div>
        <div class="col-md-6">
            <p class="mb-1"><strong>Delivery Address</strong></p>
            <p class="mb-0">@Model.DeliveryAddress</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Line Total</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>PKR @item.UnitPrice.ToString("N0")</td>
                    <td>PKR @item.LineTotal.ToString("N0")</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th>PKR @Model.TotalAmount.ToString("N0")</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <a class="btn btn-outline-secondary" asp-action="History">Back to Orders</a>
</div>
